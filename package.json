{
  "name": "atak-companion",
  "productName": "ATAK Companion",
  "version": "0.2.3",
  "description": "Companion de escritorio de ATAK.GG: overlay in-game, champ select, scoreboard y modo caster LQC. Electron puro (sin Overwolf).",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json --noEmit && vite build && electron-builder",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "gg.atak.companion",
    "productName": "ATAK Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ChristianJair27",
        "repo": "atak-companion"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ATAK-Companion-Setup-${version}.exe",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ATAK-Companion-Setup-${version}.exe",
      "shortcutName": "ATAK Companion"
    }
  }
}
